# Copy this file to .env and replace the example values with your own.
APP_NAME=ErrorLog Management
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# PostgreSQL connection
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_username
DATABASE_PASSWORD=replace_with_database_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DRIVER=postgresql+asyncpg

# Use a unique random secret of at least 32 characters.
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional seed accounts created when the application starts
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_admin_password
MANAGER_USERNAME=your_manager_username
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=replace_with_manager_password

# Mailjet credentials and verified sender addresses
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_API_SECRET=your_mailjet_api_secret
MAILJET_FROM=verified_sender@example.com
MAILJET_APPROVAL_FROM=verified_approval_sender@example.com
MAIL_FROM=verified_sender@example.com
MAIL_FROM_NAME=ErrorLog Management
